<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged by the linker into the embedded manifest of every configuration (docs/distribution_build_plan.md §2.1, §7):
     the process's ANSI code page is UTF-8, so the command line, std::filesystem::path(std::string) and every "A" API
     take the UTF-8 the engine keeps its strings in, and a Cyrillic path or user name survives; per-monitor DPI v2 (what
     main.cpp asked for at run time before; the call now finds it set), paths past MAX_PATH where the system allows them,
     and Windows 10 / 11 as the systems it was built for. In every configuration, so dev runs test what a player gets. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
