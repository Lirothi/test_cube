<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged by the linker into the embedded manifest of every configuration (docs/distribution_build_plan.md §2.1):
     the process's ANSI code page is UTF-8, so the command line, std::filesystem::path(std::string) and every "A" API
     take the UTF-8 the engine keeps its strings in, and a Cyrillic path or user name survives. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
