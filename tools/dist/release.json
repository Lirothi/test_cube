{
  "_comment": "docs/distribution_build_plan.md §8.0: what ships -- encrypted packages, every asset's licence known, zip and symbols.",
  "bootLevel": "data/levels/wind_test.json",
  "compression": "zstd:19",
  "encrypt": true,
  "graphicsDefaults": "tools/dist/graphics_defaults.json",
  "include": [
    "fonts/*.json",
    "fonts/*.tga",
    "fonts/JetBrainsMono-Regular.ttf",
    "input/bindings.json",
    "data/loading_screen.jpg",
    "data/materials/*.json"
  ],
  "levels": [
    "data/levels/wind_test.json"
  ],
  "out": "dist",
  "product": "test_cube",
  "recordArms": {
    "dlss": [
      "off",
      "balanced",
      "dlaa"
    ],
    "play": true,
    "resolutions": [
      "1920x1080",
      "2560x1440",
      "3840x2160"
    ]
  },
  "shaderList": "tools/dist/shader_list.txt",
  "shaderModel": "6.6",
  "shaderSources": true,
  "startMode": "play",
  "strictLicences": true,
  "symbols": true,
  "version": "0.1.1",
  "versionMustGrow": true,
  "vfsRecord": "tools/dist/vfs_record.txt",
  "zip": true
}
